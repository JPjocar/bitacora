# Render with scripts/configure_proxy.py; loopback is the safe default.
worker_processes 1;
error_log logs/error.log warn;
pid logs/nginx.pid;
events { worker_connections 256; }
http {
    map_hash_bucket_size 64;
    include @@MIME_TYPES@@;
    default_type application/octet-stream;
    server_tokens off;
    # Do not log query strings, cookies, passwords or request bodies.
    log_format pilot '$remote_addr [$time_local] "$request_method $uri" $status';
    access_log logs/access.log pilot;
    map "$request_method:$uri" $login_key {
        default "";
        "POST:/cuentas/ingresar/" $binary_remote_addr;
        "POST:/admin/login/" $binary_remote_addr;
    }
    limit_req_zone $login_key zone=login:10m rate=5r/m;
    server {
        listen @@BIND@@:@@HTTP_PORT@@ default_server;
        server_name @@HOST@@;
        # Fixed canonical host prevents a Host-controlled redirect.
        return 308 https://@@HOST@@@@TLS_SUFFIX@@$request_uri;
    }
    server {
        listen @@BIND@@:@@HTTPS_PORT@@ ssl default_server;
        server_name @@HOST@@;
        ssl_certificate @@CERTIFICATE@@;
        ssl_certificate_key @@KEY@@;
        ssl_protocols TLSv1.2 TLSv1.3;
        if ($host != @@HOST@@) { return 400; }
        client_max_body_size 2m;
        limit_req zone=login burst=10 nodelay;
        limit_req_status 429;
        error_page 429 /too-many-attempts.txt;
        location = /too-many-attempts.txt {
            internal;
            default_type text/plain;
            add_header Retry-After 60 always;
            add_header Cache-Control no-store always;
            return 429 "Demasiados intentos de acceso. Espere unos minutos e intente nuevamente.\n";
        }
        location ^~ /static/ {
            alias @@STATIC_ROOT@@;
            autoindex off;
            add_header X-Content-Type-Options nosniff always;
            expires 1h;
            limit_except GET { deny all; }
        }
        # No user uploads exist in this MVP; do not publish a media directory.
        location / {
            proxy_pass http://127.0.0.1:@@UPSTREAM_PORT@@;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Port "";
            proxy_set_header Forwarded "";
            proxy_connect_timeout 5s;
            proxy_read_timeout 60s;
        }
    }
}
