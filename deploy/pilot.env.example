# Copy outside version control and replace values; no passwords in command arguments.
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443
BITACORA_PUBLIC_URL=https://localhost:8443
PGDATABASE=bitacora
PGUSER=bitacora_runtime
PGPASSWORD=replace-with-a-generated-runtime-password
PGHOST=127.0.0.1
PGPORT=5432
